<mujoco model="right_shadow_hand scene">

  <include file="right_hand.xml"/>

  <statistic extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="512"/>
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>

    <texture
      type="skybox"
      builtin="gradient"
      rgb1="0.3 0.5 0.7"
      rgb2="0 0 0"
      width="512"
      height="3072"/>

    <texture
      type="2d"
      name="groundplane"
      builtin="checker"
      mark="edge"
      rgb1="0.2 0.3 0.4"
      rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8"
      width="300"
      height="300"/>

    <material
      name="groundplane"
      texture="groundplane"
      texuniform="true"
      texrepeat="5 5"
      reflectance="0.2"/>

  </asset>


  <worldbody>

    <light pos="0 0 1"/>

    <light
      pos="0.3 0 1.5"
      dir="0 0 -1"
      directional="true"/>

    <geom
      name="floor"
      pos="0 0 -0.1"
      size="0 0 0.05"
      type="plane"
      material="groundplane"/>


    <!-- ================================================== -->
    <!-- CHOPSTICK ASSEMBLY                                 -->
    <!-- ================================================== -->

    <body
      name="chopstick_frame"
      pos="0.34 -0.005 0.022"
      euler="0 0 -20">

      <freejoint/>


      <!-- LOWER CHOPSTICK -->

      <body name="lower_chopstick">

        <geom
          name="lower_chopstick_geom"
          type="capsule"
          fromto="-0.10 0 0 0.10 0 0"
          size="0.004"
          rgba="0.72 0.52 0.30 1"
          friction="1.5 0.01 0.001"/>

        <site
          name="lower_actual_back"
          pos="-0.05 0 0"
          size="0.0025"
          rgba="0 1 0 1"/>

        <site
          name="lower_actual_front"
          pos="0.03 0 0"
          size="0.0025"
          rgba="0 1 0 1"/>

        <site
          name="lower_tip"
          pos="0.10 0 0"
          size="0.003"
          rgba="0 1 0 1"/>

      </body>


      <!-- UPPER CHOPSTICK -->

      <body
        name="upper_chopstick"
        pos="0 -0.025 0.008">

        <joint
          name="upper_chopstick_hinge"
          type="hinge"
          pos="-0.08 0 0"
          axis="0 0 1"
          range="-20 20"
          damping="0.05"/>

        <geom
          name="upper_chopstick_geom"
          type="capsule"
          fromto="-0.10 0 0 0.10 0 0"
          size="0.004"
          rgba="0.72 0.52 0.30 1"
          friction="1.5 0.01 0.001"/>

        <site
          name="upper_actual_back"
          pos="-0.05 0 0"
          size="0.0025"
          rgba="0 0.5 1 1"/>

        <site
          name="upper_actual_front"
          pos="0.03 0 0"
          size="0.0025"
          rgba="0 0.5 1 1"/>

        <site
          name="upper_tip"
          pos="0.10 0 0"
          size="0.003"
          rgba="0 0.5 1 1"/>

      </body>


      <!-- GUIDE MARKERS -->

      <site
        name="lower_guide_back_center"
        pos="-0.05 0 0"
        size="0.002"
        rgba="0 1 0 0.5"/>

      <site
        name="lower_guide_front_center"
        pos="0.03 0 0"
        size="0.002"
        rgba="0 1 0 0.5"/>

      <site
        name="upper_guide_back_center"
        pos="-0.05 -0.025 0.008"
        size="0.002"
        rgba="0 0.5 1 0.5"/>

      <site
        name="upper_guide_front_center"
        pos="0.03 -0.025 0.008"
        size="0.002"
        rgba="0 0.5 1 0.5"/>

    </body>


    <!-- ================================================== -->
    <!-- GRASP OBJECT                                       -->
    <!-- ================================================== -->

    <body
      name="grasp_object"
      pos="0.37211 -0.09541 0.02904">

      <joint
        name="object_vertical_joint"
        type="slide"
        axis="0 0 1"
        range="0 0.06"
        limited="true"
        damping="0.10"/>

      <geom
        name="grasp_object_geom"
        type="sphere"
        size="0.002"
        mass="0.001"
        rgba="0.90 0.10 0.10 1"
        friction="2.0 0.01 0.001"/>

    </body>

  </worldbody>


  <!-- ================================================== -->
  <!-- CHOPSTICK SERVO                                     -->
  <!-- ================================================== -->

  <actuator>

    <position
      name="upper_chopstick_servo"
      joint="upper_chopstick_hinge"
      kp="20"
      gear="1"
      ctrllimited="true"
      ctrlrange="-0.349066 0.349066"
      forcelimited="true"
      forcerange="-2 2"/>

  </actuator>


  <!-- ================================================== -->
  <!-- CONSTRAINTS                                        -->
  <!-- ================================================== -->

  <equality>

    <weld
      name="chopstick_grip"
      body1="chopstick_frame"
      body2="rh_palm"/>

  </equality>

</mujoco>