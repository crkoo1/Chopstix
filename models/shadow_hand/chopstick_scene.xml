<mujoco model="right_shadow_hand scene">
  <include file="right_hand.xml"/>

  <statistic extent="0.3"/>

  <visual>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="512"/> <!-- reduced from 8192 to prevent my computer from crashing-->
    <global azimuth="220" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1"/>
    <light pos="0.3 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" pos="0 0 -0.1" size="0 0 0.05" type="plane" material="groundplane"/>
    <body name="lower_chopstick" pos="0.34 -0.005 0.022">
      <freejoint/>
      <geom
        type="capsule"
        fromto="-0.10 0 0  0.10 0 0"
        size="0.004"
        rgba="0.72 0.52 0.30 1"/>
    </body>
    <body name="upper_chopstick" pos="0.34 -0.040 0.030">
      <freejoint/>
      <geom
        type="capsule"
        fromto="-0.10 0 0  0.10 0 0"
        size="0.004"
        rgba="0.72 0.52 0.30 1"/>
    </body>
  </worldbody>
  <equality>

    <weld
      name="lower_chopstick_grip"
      body1="lower_chopstick"
      body2="rh_palm"/>

    <connect
      name="upper_chopstick_pivot"
      body1="upper_chopstick"
      body2="rh_palm"
      anchor="-0.08 0 0"/>

  </equality>
</mujoco>
